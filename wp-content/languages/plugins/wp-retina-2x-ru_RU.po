#: common/admin.php:129 common/admin.php:130
msgid "Dashboard"
msgstr "Консоль"

#: classes/core.php:645
msgid "PRO VERSION ONLY"
msgstr "Только в PRO версии"

#. Author of the plugin
msgid "Jordy Meow"
msgstr "Jordy Meow"

#: classes/rest.php:319
msgid "You do not have permission to upload files."
msgstr "У вас нет прав на загрузку файлов."

#: classes/core.php:730
msgid "This size is ignored by your retina settings."
msgstr "Этот размер проигнорирован вашими ретина настройками."

#: classes/core.php:725
msgid "The standard image normally created by WordPress is missing."
msgstr "Стандартное изображение, которое обычно создаётся с помощью WordPress, отсутствует."

#: classes/core.php:720
msgid "The retina image can be created. Please use the 'GENERATE' button."
msgstr "Может быть сгенерировано ретина изображение. Пожалуйста, нажмите кнопку 'СГЕНЕРИРОВАТЬ'."

#: classes/core.php:710
msgid "The Full-Size image is too small (<b>%dx%d</b>) and this size cannot be generated.<br />Please upload an image of at least <b>%dx%d</b>."
msgstr "Полноразмерное изображение слишком маленькое (<b>%dx%d</b>) и этот размер не может быть сгенерирован.<br />Пожалуйста, загрузите изображение не менее <b>%dx%d</b>."

#: classes/core.php:706
msgid "The retina version of the Full-Size image is missing.<br />Full Size Retina has been checked in the Settings and this image is therefore required.<br />Please drag & drop an image of at least <b>%dx%d</b> in the <b>Full-Size Retina Upload</b> column."
msgstr "Ретина версия полноразмерного изображения отсутствует.<br />В настройках был отмечен Полный размер Ретина, поэтому теперь требуется такое изображение.<br />Пожалуйста, методом простого перетаскивания перетащите изображение по меньшей мере <b>%dx%d</b> в колонку <b>Полный-размер Ретина Загрузить</b>."

#: classes/core.php:688
msgid "The image size '%s' could not be found. You probably changed your image sizes but this specific image was not re-build. This is not related to the retina plugin. You should probably use a plugin to re-generate the missing metadata and images."
msgstr "Размер изображения '%s' не найден. Возможно, вы изменили размеры изображения, но именно это изображение не было перестроено. Это не связано с ретина плагином. Вы можете попробовать использовать плагин, чтобы регенерировать потерянные метаданные и изображения."

#: classes/core.php:684
msgid "The metadata is broken! This is not related to the retina plugin. You should probably use a plugin to re-generate the missing metadata and images."
msgstr "Метаданные повреждены! Это не связано с ретина плагином. Вы можете попробовать использовать плагин, чтобы регенерировать потерянные метаданные и изображения."

#: classes/core.php:574
msgid "N/A"
msgstr "Н/Д"