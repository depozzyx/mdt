{"translation-revision-date":"2021-04-18 15:43:00+0000","generator":"GlotPress\/3.0.0-alpha.2","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","plural-forms":"nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);","lang":"uk_UA"},"All":["\u0412\u0441\u0435"],"Font size":["\u0420\u043e\u0437\u043c\u0456\u0440 \u0448\u0440\u0438\u0444\u0442\u0443"],"Type":["\u0422\u0438\u043f"],"Custom":["\u0414\u043e\u0432\u0456\u043b\u044c\u043d\u0438\u0439"],"Mixed":["\u0417\u043c\u0456\u0448\u0430\u043d\u0438\u0439"],"Hours":["\u0413\u043e\u0434\u0438\u043d"],"No results.":["\u041d\u0435\u043c\u0430\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432."],"Custom color picker":["\u0414\u043e\u0432\u0456\u043b\u044c\u043d\u0438\u0439 \u0432\u0438\u0431\u0456\u0440 \u043a\u043e\u043b\u044c\u043e\u0440\u0443"],"Color code: %s":["\u041a\u043e\u043b\u0456\u0440: %s"],"Color: %s":["\u041a\u043e\u043b\u0456\u0440: %s"],"Alpha value, from 0 (transparent) to 1 (fully opaque).":["\u0417\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0410\u043b\u044c\u0444\u0430 \u0432\u0456\u0434 0 (\u043f\u0440\u043e\u0437\u043e\u0440\u0438\u0439) \u0434\u043e 1 (\u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u043d\u0435\u043f\u0440\u043e\u0437\u043e\u0440\u0438\u0439)."],"Hue value in degrees, from 0 to 359.":["\u0417\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u0442\u0456\u043d\u043a\u0443 \u0432 \u0433\u0440\u0430\u0434\u0443\u0441\u0430\u0445, \u0432\u0456\u0434 0 \u0434\u043e 359."],"%d result found, use up and down arrow keys to navigate.":["\u0417\u043d\u0430\u0439\u0434\u0435\u043d\u043e %d \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0441\u0442\u0440\u0456\u043b\u043a\u0438 \u043d\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0456 \u0434\u043b\u044f \u0